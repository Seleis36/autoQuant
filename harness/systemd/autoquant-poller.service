[Unit]
Description=autoQuant PR poller and watchdog
After=network-online.target
Wants=network-online.target
PartOf=autoquant.target

[Service]
Type=simple
WorkingDirectory=%h/autoQuant
ExecStart=%h/autoQuant/harness/poll_prs.sh --daemon
Restart=always
RestartSec=30
StandardOutput=append:%h/autoQuant/harness/logs/poller.log
StandardError=append:%h/autoQuant/harness/logs/poller.log

[Install]
WantedBy=autoquant.target
